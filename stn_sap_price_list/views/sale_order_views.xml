<odoo>
    <record id="view_sale_order_form_inherit_sap_price_list" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sap.price.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//*[self::list or self::tree]//field[@name='product_id']" position="before">
                <field name="product_image" widget="image" options="{'size': [48, 48]}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//*[self::list or self::tree]//field[@name='product_id']" position="after">
                <field name="sap_price_list_id"/>
            </xpath>

        </field>
    </record>
</odoo>
