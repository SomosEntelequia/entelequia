<odoo>
    <record id="action_sap_price_list" model="ir.actions.act_window">
        <field name="name">Listas de precio SAP</field>
        <field name="res_model">sap.price.list</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_sap_price_list"
        name="Listas de precio SAP"
        parent="sale.menu_sale_config"
        action="action_sap_price_list"
        sequence="55"
    />

    <record id="view_sap_price_list_list" model="ir.ui.view">
        <field name="name">sap.price.list.list</field>
        <field name="model">sap.price.list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sap_price_list_form" model="ir.ui.view">
        <field name="name">sap.price.list.form</field>
        <field name="model">sap.price.list</field>
        <field name="arch" type="xml">
            <form string="Lista de precio SAP">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="id_secundario_sap"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
