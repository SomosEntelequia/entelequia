<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_stn_stock_snapshot" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.stn.stock.snapshot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="after">
                <field name="stn_existencia" readonly="1" optional="show"/>
                <field name="stn_comprometido" readonly="1" optional="show"/>
                <field name="stn_disponible_para_uso" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
