<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_line_warehouse" model="ir.ui.view">
        <field name="name">sale.order.form.line.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <!-- Agregar después del campo product_uom_qty (cantidad) -->
            <xpath
                expr="/form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list//field[@name='name']"
                position="after">
                <field name="line_warehouse_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>