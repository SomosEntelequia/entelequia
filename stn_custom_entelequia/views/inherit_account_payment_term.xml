<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="view_payment_term_form_sap_inherit" model="ir.ui.view">
            <field name="name">account.payment.term.form.sap.inherit</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <group>
                        <field name="sap_payment_term_code"
                            string="Código SAP"
                            placeholder="Ej: Z001"
                            help="Este código se enviará a SAP en el campo PaymentTermCode" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>