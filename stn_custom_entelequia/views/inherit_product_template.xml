<odoo>
    <record id="stn_view_product_template_form_inherit_stn" model="ir.ui.view">
        <field name="name">product.template.form.inherit.stn</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="id_secundario_sap"/>
                <field name="grupo_de_unidad_de_medida_sap" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>