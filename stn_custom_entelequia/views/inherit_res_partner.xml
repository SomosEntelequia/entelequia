<odoo>
    <record id="stn_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sync_sap_contact"
                        string="Convertir a Cliente SAP"
                        type="object"
                        class="oe_highlight"
                        invisible="u_is_sap_client == True" />

                    <!-- Botón para actualización individual - Solo cuando YA está sincronizado -->
                    <button name="action_update_sap_contact"
                        string="Actualizar en SAP"
                        type="object"
                        class="btn-warning"
                        invisible="u_has_pending_changes == False or parent_id != False" />
                </header>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="id_secondary" string="ID Secundario SAP" readonly="1" />
                <field name="u_is_sap_client" string="Es Cliente SAP" widget="boolean_toggle" />
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="General SAP" name="sap_logistics">
                    <group>
                        <group string="Días de Entrega">
                            <field name="u_entrega_lunes" />
                            <field name="u_entrega_martes" />
                            <field name="u_entrega_miercoles" />
                            <field name="u_entrega_jueves" />
                            <field name="u_entrega_viernes" />
                            <field name="u_entrega_sabado" />
                            <field name="u_entrega_domingo" />
                        </group>
                        <group string="Horarios y Estatus">
                            <field name="u_hora_entrega_inicio" />
                            <field name="u_hora_entrega_fin" />
                            <field name="u_estatus_cliente" />
                            <field name="u_dias_revision" />
                        </group>
                    </group>
                    <group string="Gestión de Crédito SAP" name="group_sap_credit">
                        <group>
                            <field name="u_sap_use_credit_limit" widget="boolean_toggle" />
                            <field name="u_sap_credit_limit" invisible="not u_sap_use_credit_limit" />
                        </group>
                        <group>
                            <field name="u_sap_credit_balance" />
                            <field name="u_sap_credit_available"
                                decoration-success="u_sap_credit_available &gt; 0"
                                decoration-danger="u_sap_credit_available &lt;= 0" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>