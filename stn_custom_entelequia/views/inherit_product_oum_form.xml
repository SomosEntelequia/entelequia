<odoo>
    <record id="view_uom_uom_form_sap_inherit" model="ir.ui.view">
        <field name="name">uom.uom.form.sap.inherit</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">

            <!-- Este campo sí existe -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="grupo_de_unidad_de_medida_sap"/>
                <field name="cantidad_base_sap"/>
            </xpath>

            <!-- Este div sí existe también -->
            <xpath expr="//div[@name='relative_factor']" position="after">
                <field name="cantidad_de_equivalencia"/>
            </xpath>

        </field>
    </record>
</odoo>
