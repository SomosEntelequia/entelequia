<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stn_view_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.sap</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="u_sap_doc_num" readonly="1" string="Folio SAP"
                        invisible="not u_sap_doc_num" />
                    <field name="u_estado" widget="badge"
                        decoration-info="u_estado == '0'"
                        decoration-success="u_estado in ('1','2')"
                        decoration-danger="u_estado == '3'"
                        decoration-warning="u_estado in ('5','6')" />
                </xpath>

                <!-- Agregar campos de direcciones SAP después del partner_id -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_shipping_id_sap"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="Seleccionar dirección de envío..."
                        invisible="not partner_id" />
                    <field name="partner_invoice_id_sap"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="Seleccionar dirección de facturación..."
                        invisible="not partner_id" />
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Sincronización SAP" name="sap_logistics">
                        <group>
                            <group string="Direcciones SAP">
                                <field name="partner_shipping_id_sap"
                                    options="{'no_create': True}"
                                    context="{'show_address': 1}"
                                    string="Dir. de Envío (ShipToCode)" />
                                <field name="partner_invoice_id_sap"
                                    options="{'no_create': True}"
                                    context="{'show_address': 1}"
                                    string="Dir. de Facturación (PayToCode)" />
                            </group>
                            <group string="Referencias y Pago">
                                <field name="u_numRef" />
                                <field name="u_referencia_pago" />
                                <field name="u_sap_notes" placeholder="Notas que viajarán a SAP..." />
                            </group>
                        </group>
                        <group>
                            <group string="Logística de Entrega">
                                <field name="u_cond_entrega" />
                                <field name="u_form_envio" />
                                <field name="u_tipo_pedido" />
                                <field name="u_tipo_envio" />
                                <field name="u_zona" />
                            </group>
                            <group string="Incidencias (Devolución/Cancelación)">
                                <field name="u_tipo_devolucion" required="u_estado in ('5','6')" />
                                <field name="u_devolucion" required="u_estado in ('5','6')" />
                                <field name="u_cancelacion" invisible="u_estado != '3'" />
                            </group>
                        </group>
                        <group>
                            <group string="Documentos Relacionados SAP">
                                <field name="u_sap_invoice_num" readonly="1" />
                                <field name="u_sap_delivery_num" readonly="1" />
                                <field name="u_sap_credit_note_num" readonly="1" />
                                <field name="u_sap_folio_devolucion" readonly="1" />
                            </group>
                            <group string="Datos Técnicos">
                                <field name="u_sap_id" readonly="1" groups="base.group_no_one" />
                                <field name="u_sap_doc_num" readonly="1" />
                                <field name="x_payload_printed" readonly="1" />
                            </group>
                        </group>
                    </page>
                </xpath>              
            </field>
        </record>
    </data>
</odoo>